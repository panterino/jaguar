rules_version = '2';

// Jaguar: classes (teachers and students), community publications and the
// support network. Many users are minors: no personal data is required,
// students only see their own work, and nobody can list other people.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Only the listed fields, so nobody can sneak in extra data.
    function onlyFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function shortText(field, max) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() > 0
        && request.resource.data[field].size() <= max;
    }

    // Profile: an alias and a role. Read and written only by its owner.
    match /users/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && onlyFields(['alias', 'role', 'classes', 'createdAt'])
        && shortText('alias', 40)
        && request.resource.data.role in ['alumno', 'profesor', 'autodidacta']
        && (!('classes' in request.resource.data)
            || (request.resource.data.classes is list && request.resource.data.classes.size() <= 100));
    }

    // A class code points to its class. It can be read only by asking for
    // that exact code (no listing), so knowing the code is the key.
    match /classCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && onlyFields(['classId', 'ownerId'])
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /classes/{classId} {
      function owner() {
        return get(/databases/$(database)/documents/classes/$(classId)).data.ownerId;
      }
      function isOwner() {
        return signedIn() && owner() == request.auth.uid;
      }
      function isMember() {
        return signedIn() && exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid));
      }
      function isOpen() {
        return get(/databases/$(database)/documents/classes/$(classId)).data.get('open', true) == true;
      }

      allow get: if isOwner() || isMember();
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      // "open" lets the teacher close the class to new students; a class
      // without the field is open.
      allow create: if signedIn()
        && onlyFields(['name', 'ownerId', 'ownerAlias', 'code', 'createdAt', 'open'])
        && request.resource.data.ownerId == request.auth.uid
        && shortText('name', 60)
        && shortText('ownerAlias', 40)
        && shortText('code', 24)
        && (!('open' in request.resource.data) || request.resource.data.open is bool);
      allow update: if isOwner()
        && onlyFields(['name', 'ownerId', 'ownerAlias', 'code', 'createdAt', 'open'])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.code == resource.data.code
        && shortText('name', 60)
        && shortText('ownerAlias', 40)
        && (!('open' in request.resource.data) || request.resource.data.open is bool);
      allow delete: if isOwner();

      // Joining needs the class code; a student sees only themselves, the
      // teacher sees everyone.
      match /members/{uid} {
        allow get: if isMe(uid) || isOwner();
        allow list: if isOwner();
        allow create: if isMe(uid)
          && onlyFields(['name', 'role', 'code', 'joinedAt'])
          && request.resource.data.role == 'alumno'
          && request.resource.data.code == get(/databases/$(database)/documents/classes/$(classId)).data.code
          && isOpen()
          && shortText('name', 60);
        allow update: if isMe(uid)
          && onlyFields(['name', 'role', 'code', 'joinedAt'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.code == resource.data.code
          && shortText('name', 60);
        allow delete: if isMe(uid) || isOwner();
      }

      // The hidden tests of each assignment (same id), for the teacher only.
      match /hiddenCases/{assignmentId} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && onlyFields(['cases'])
          && request.resource.data.cases is list
          && request.resource.data.cases.size() <= 50;
      }

      // Exercises assigned by the teacher. The teacher's solution never
      // comes here: it stays on the teacher's device. Students read the visible
      // tests only: the hidden ones live in hiddenCases, which only the teacher
      // reads, and "hiddenCount" tells the students how many there are.
      match /assignments/{assignmentId} {
        allow read: if isOwner() || isMember();
        allow create, update: if isOwner()
          && onlyFields(['title', 'exercise', 'createdAt', 'dueAt', 'hiddenCount'])
          && shortText('title', 120)
          && request.resource.data.exercise is map
          && request.resource.data.exercise.size() <= 20
          && (!('hiddenCount' in request.resource.data)
              || (request.resource.data.hiddenCount is int
                  && request.resource.data.hiddenCount >= 0
                  && request.resource.data.hiddenCount <= 50));
        allow delete: if isOwner();

        // One submission per student, rewritten on every Probar.
        match /submissions/{uid} {
          allow read: if isMe(uid) || isOwner();
          // "passed" and "total" are what the student says: the teacher's app
          // runs the program again against every test, hidden ones included,
          // and shows that result. The rules only keep them sane.
          allow create, update: if isMe(uid) && isMember()
            && onlyFields(['name', 'source', 'passed', 'total', 'pasted', 'updatedAt'])
            && shortText('name', 60)
            && request.resource.data.source is string
            && request.resource.data.source.size() <= 50000
            && request.resource.data.passed is int
            && request.resource.data.total is int
            && request.resource.data.passed >= 0
            && request.resource.data.passed <= request.resource.data.total
            && request.resource.data.total <= 500
            // Most lines pasted at once, for the teacher. Optional.
            && (!('pasted' in request.resource.data)
                || (request.resource.data.pasted is int && request.resource.data.pasted > 0
                    && request.resource.data.pasted <= 5000));
          // The student can take their work back (deleting their account).
          allow delete: if isMe(uid) || isOwner();
        }
      }
    }

    // Community: programs, exercises and tutorials anyone can open, try and
    // remix. Authors are shown by alias only.
    match /publications/{pubId} {
      allow read: if resource.data.status == 'publicado' || (signedIn() && resource.data.authorId == request.auth.uid);
      allow create: if signedIn()
        && onlyFields(['kind', 'title', 'description', 'topic', 'authorId', 'authorAlias', 'content',
                       'remixOf', 'status', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'publicado'
        && request.resource.data.kind in ['programa', 'ejercicio', 'tutorial']
        && shortText('title', 120)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.content is map
        && request.resource.data.content.size() <= 20;
      // The author can hide and show their own, and fix it. A publication a
      // moderator marked "moderado" (in the console) is out of their hands.
      allow update: if signedIn() && resource.data.authorId == request.auth.uid
        && resource.data.status in ['publicado', 'oculto']
        && request.resource.data.status in ['publicado', 'oculto']
        && onlyFields(['kind', 'title', 'description', 'topic', 'authorId', 'authorAlias', 'content',
                       'remixOf', 'status', 'createdAt'])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.createdAt == resource.data.createdAt
        && shortText('title', 120)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.content is map
        && request.resource.data.content.size() <= 20;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      // "Me sirvió": one per person. Anyone can count them, so the ids are
      // readable: they are random ones from Firebase, never a name or an alias.
      match /useful/{uid} {
        allow read: if true;
        allow create: if isMe(uid) && request.resource.data.keys().size() == 0;
        allow delete: if isMe(uid);
      }
    }

    // Anyone signed in can report; only moderators (in the console) read.
    match /reports/{reportId} {
      allow create: if signedIn()
        && onlyFields(['publicationId', 'reporterId', 'reason', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.publicationId is string
        && request.resource.data.publicationId.size() > 0
        && request.resource.data.publicationId.size() <= 64
        && shortText('reason', 500);
    }

    // Support network: verified offers, added by Panterino from the console.
    match /supportOffers/{offerId} {
      allow read: if resource.data.verified == true;
    }

    // Messages from the landing page (teachers who want to try Jaguar,
    // suggestions). Anyone can leave one; only Panterino reads them, in the
    // console. The contact is optional.
    match /mensajes/{id} {
      allow create: if onlyFields(['tipo', 'mensaje', 'escuela', 'contacto', 'creado'])
        && request.resource.data.tipo in ['piloto', 'sugerencia', 'datos']
        && shortText('mensaje', 2000)
        && (!('escuela' in request.resource.data) || shortText('escuela', 200))
        && (!('contacto' in request.resource.data) || shortText('contacto', 200))
        && request.resource.data.creado == request.time;
    }

    // List from the landing page: a person leaves an email to be told when
    // Jaguar launches. The id is random, so nobody can find out whether an
    // address is on the list by trying to add it (a repeated address is just
    // a second entry, which Panterino sees in the console). Only Panterino
    // reads them.
    match /accesoAnticipado/{id} {
      allow create: if onlyFields(['correo', 'origen', 'creado'])
        && request.resource.data.correo is string
        && request.resource.data.correo.size() >= 6
        && request.resource.data.correo.size() <= 200
        && request.resource.data.correo.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.origen in ['inicio', 'acceso', 'guia']
        && request.resource.data.creado == request.time;
    }
  }
}
